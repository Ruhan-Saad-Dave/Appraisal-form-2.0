# =========================================================================
# Faculty Appraisal Frontend (Appraisal-form-2.0) Environment Configuration
# Copy this file to '.env' and adjust values for your environment.
# =========================================================================

# --- 1. Backend API Endpoint Configuration ---
# If hosted on the same origin (e.g., reverse proxy), leave commented or set to /api/v1.
# For standalone local dev:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- 2. Keycloak / DYPIU SSO (OIDC + PKCE) Configuration ---
# Base URL of DYPIU Keycloak instance (omit or leave empty to disable SSO redirect)
VITE_KEYCLOAK_URL=https://auth.dypiu.ac.in

# Keycloak realm name
VITE_KEYCLOAK_REALM=dypiu

# Keycloak OIDC Public Client ID for Faculty Appraisal Frontend
VITE_KEYCLOAK_CLIENT_ID=faculty-appraisal-frontend

# OIDC scopes
VITE_KEYCLOAK_SCOPES=openid email profile